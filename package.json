{
  "name": "cordoba-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node apps/worker/scripts/embed-data.mjs && vitest run",
    "scrape": "pnpm --filter @cordoba/scraper run run",
    "bootstrap": "node scripts/bootstrap.mjs",
    "deploy": "pnpm --filter @cordoba/worker run deploy",
    "dev:worker": "pnpm --filter @cordoba/worker run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
