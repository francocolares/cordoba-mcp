---
import type { Fuente } from "../data/content";
import Badge from "./Badge.astro";

interface Props {
  fuente: Fuente;
}

const { fuente } = Astro.props;
---

<article
  class:list={[
    "rounded-card border p-5",
    fuente.lista ? "border-accent/35 bg-surface" : "border-line bg-white/[0.015]",
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class={`text-lg ${fuente.lista ? "" : "text-dove"}`}>{fuente.nombre}</h3>
      <p class="mt-1 text-sm text-muted">
        {fuente.enlace ? <a href={fuente.enlace}>{fuente.organismo}</a> : fuente.organismo}
      </p>
    </div>
    <Badge tone={fuente.lista ? "accent" : "quiet"}>{fuente.lista ? "activa" : "pendiente"}</Badge>
  </div>
</article>
