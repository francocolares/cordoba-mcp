---
import type { Fuente } from "../data/content";
import Badge from "./Badge.astro";

interface Props {
  fuente: Fuente;
}

const { fuente } = Astro.props;
---

<article
  class:list={[
    "flex flex-col gap-3 rounded-card border p-5",
    fuente.lista ? "border-accent/35 bg-surface" : "border-line bg-white/[0.015]",
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class={`text-lg ${fuente.lista ? "" : "text-dove"}`}>{fuente.nombre}</h3>
      <p class="mt-1 text-sm text-muted">
        {fuente.enlace ? <a href={fuente.enlace}>{fuente.organismo}</a> : fuente.organismo}
      </p>
    </div>
    <Badge tone={fuente.lista ? "accent" : "quiet"}>{fuente.lista ? "activa" : "pendiente"}</Badge>
  </div>

  <p class="text-sm text-muted">{fuente.responde}</p>

  {
    fuente.nota && (
      <p class="mt-auto border-t border-line pt-3 font-mono text-xs text-muted">{fuente.nota}</p>
    )
  }
</article>
