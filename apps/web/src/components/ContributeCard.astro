---
import type { Via } from "../data/content";
import CheckIcon from "./CheckIcon.astro";
import PlayIcon from "./PlayIcon.astro";
import SourceIcon from "./SourceIcon.astro";
import ViaCta from "./ViaCta.astro";
import VideoModal from "./VideoModal.astro";

interface Props {
  via: Via;
}

const { via } = Astro.props;
const { destacada } = via;

const modal = `video-${via.id}`;
---

<article
  class:list={[
    "via relative isolate flex flex-col overflow-hidden rounded-card border bg-surface p-6 sm:p-8",
    destacada ? "destacada border-accent/30" : "border-line",
  ]}
>
  <SourceIcon
    name={via.icono}
    class:list={[
      "pointer-events-none absolute -top-8 -right-8 -z-10 size-44 sm:-top-10 sm:-right-10 sm:size-56",
      destacada ? "text-accent/[0.09]" : "text-ink/[0.06]",
    ]}
  />

  <header class="border-b border-line pb-5">
    <p
      class:list={[
        "font-mono text-[10px] uppercase tracking-[0.2em]",
        destacada ? "text-accent" : "text-muted",
      ]}
    >
      {via.rotulo}
    </p>
    <h3 class="mt-2.5 text-pretty text-2xl">{via.titulo}</h3>
    <p class="mt-2.5 max-w-[46ch] text-pretty text-sm leading-relaxed text-muted">{via.cuerpo}</p>
  </header>

  <ul class="mt-5 mb-6 space-y-2.5">
    {
      via.puntos.map((punto) => (
        <li class="flex gap-2.5">
          <span
            class:list={[
              "mt-0.5 flex size-[18px] flex-none items-center justify-center rounded-full border border-line-strong bg-bg",
              destacada ? "text-accent" : "text-dove",
            ]}
            aria-hidden="true"
          >
            <CheckIcon class="size-2.5" />
          </span>
          <p class="min-w-0 text-pretty text-sm leading-snug text-body">{punto}</p>
        </li>
      ))
    }
  </ul>

  <footer class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-line pt-5">
    <ViaCta cta={via.cta} evento={`via_${via.id}`} acento={destacada} />

    {
      via.video && (
        <button
          type="button"
          data-abrir-video={modal}
          data-evento={`via_${via.id}_video`}
          class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-ink"
        >
          <PlayIcon class="size-4" />
          {via.video.texto}
        </button>
      )
    }
  </footer>

  {
    via.video && (
      <VideoModal id={modal} titulo={via.video.titulo} fuente={via.video.fuente}>
        <ViaCta cta={via.cta} evento={`via_${via.id}_video_cita`} acento />
      </VideoModal>
    )
  }
</article>

<style>
  .via {
    background-image: linear-gradient(145deg, rgba(255, 255, 255, 0.022), transparent 42%);
    transition: border-color 280ms ease;
  }

  .via:hover {
    border-color: var(--color-line-strong);
  }

  .via.destacada:hover {
    border-color: color-mix(in oklab, var(--color-accent) 55%, transparent);
  }
</style>
