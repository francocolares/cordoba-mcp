---
/**
 * Ficha de una vía de contribución. Toma prestado el lenguaje de la tarjeta de
 * conexión (`ClaudeSetup`): mismo recuadro, mismo rótulo mono arriba, el ícono
 * grande y casi apagado firmando el bloque desde la esquina, y la lista
 * separada por hairlines en lugar de viñetas. Lo único que cambia entre las
 * dos vías es el acento; la estructura es la misma, para que se lean como un
 * par y no como dos piezas distintas.
 *
 * El último punto de la lista lleva su propio `pb-6` —y no el `pb-0` del
 * instructivo— porque acá el footer se empuja con `mt-auto` para alinear los
 * botones de las dos fichas: en la más alta ese margen queda en cero y, sin
 * padding propio, el último ítem terminaba apoyado contra la línea.
 */
import type { Via } from "../data/content";
import BrandIcon from "./BrandIcon.astro";
import CheckIcon from "./CheckIcon.astro";
import SourceIcon from "./SourceIcon.astro";

interface Props {
  via: Via;
}

const { via } = Astro.props;
const { destacada } = via;

/** Sale de la página todo lo que no sea correo ni anclaje interno. */
const esExterno = (href: string) => !href.startsWith("mailto:") && !href.startsWith("#");

const ctaExterno = esExterno(via.cta.href);
const extraExterno = via.extra ? esExterno(via.extra.href) : false;
---

<article
  class:list={[
    "via relative isolate flex flex-col overflow-hidden rounded-card border bg-surface p-6 sm:p-9",
    destacada ? "destacada border-accent/30" : "border-line",
  ]}
>
  {/*
    El ícono grande y bajísimo de opacidad, como la marca de Claude en la
    tarjeta de conexión: firma el bloque sin pedir un recuadro propio.
  */}
  <SourceIcon
    name={via.icono}
    class:list={[
      "pointer-events-none absolute -top-8 -right-8 -z-10 size-44 sm:-top-10 sm:-right-10 sm:size-56",
      destacada ? "text-accent/[0.09]" : "text-ink/[0.06]",
    ]}
  />

  <header class="border-b border-line pb-6">
    <p
      class:list={[
        "font-mono text-[10px] uppercase tracking-[0.2em]",
        destacada ? "text-accent" : "text-muted",
      ]}
    >
      {via.rotulo}
    </p>
    <h3 class="mt-3 text-pretty text-2xl">{via.titulo}</h3>
    <p class="mt-3 max-w-[46ch] text-pretty text-sm leading-relaxed text-muted">{via.cuerpo}</p>
  </header>

  <ul class="mt-1">
    {
      via.puntos.map((punto) => (
        <li class="flex gap-4 border-b border-line py-5 last:border-b-0 last:pb-6">
          <span
            class:list={[
              "mt-px flex size-6 flex-none items-center justify-center rounded-full border border-line-strong bg-bg",
              destacada ? "text-accent" : "text-dove",
            ]}
            aria-hidden="true"
          >
            <CheckIcon class="size-3" />
          </span>
          <p class="min-w-0 text-pretty text-sm leading-relaxed text-body">{punto}</p>
        </li>
      ))
    }
  </ul>

  <footer class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-line pt-6">
    <a
      href={via.cta.href}
      data-evento={`via_${via.id}`}
      target={ctaExterno ? "_blank" : undefined}
      rel={ctaExterno ? "noopener noreferrer" : undefined}
      class:list={[
        "inline-flex items-center gap-2 rounded-card px-4 py-2.5 text-sm font-medium no-underline transition-colors",
        destacada
          ? "bg-accent text-jet hover:bg-accent-soft"
          : "border border-line-strong bg-bg text-ink hover:bg-white/[0.06]",
      ]}
    >
      {via.cta.marca && <BrandIcon name={via.cta.marca} class="size-[18px]" />}
      {via.cta.icono && <SourceIcon name={via.cta.icono} class="size-[18px]" />}
      {via.cta.texto}
      {ctaExterno && <span aria-hidden="true" class="opacity-60">↗</span>}
    </a>

    {
      via.extra && (
        <a
          href={via.extra.href}
          target={extraExterno ? "_blank" : undefined}
          rel={extraExterno ? "noopener noreferrer" : undefined}
          class="text-sm text-muted no-underline hover:text-ink"
        >
          {via.extra.texto}
          {extraExterno && <span aria-hidden="true"> ↗</span>}
        </a>
      )
    }
  </footer>
</article>

<style>
  /* El mismo barniz tenue que llevan las fichas de fuentes, sin el lift. */
  .via {
    background-image: linear-gradient(145deg, rgba(255, 255, 255, 0.022), transparent 42%);
    transition: border-color 280ms ease;
  }

  .via:hover {
    border-color: var(--color-line-strong);
  }

  .via.destacada:hover {
    border-color: color-mix(in oklab, var(--color-accent) 55%, transparent);
  }
</style>
