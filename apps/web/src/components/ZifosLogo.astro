</a>

<canvas data-fuego aria-hidden="true" class="fuego"></canvas>

<audio data-fuego-audio src="/audio/fuego.mp3" preload="none" loop aria-hidden="true"></audio>

<p class="aviso-sonido" data-aviso-sonido aria-hidden="true" hidden>
  presioná <kbd>S</kbd> para habilitar el sonido
</p>

<style>
  .fuego {
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100lvh;
    z-index: 40;
    pointer-events: none;
    opacity: 0;
    transition: opacity 180ms linear;
  }

  .fuego[data-prendido] {
    opacity: 1;
  }

  .aviso-sonido {
    position: fixed;
    left: 50%;
    bottom: max(1.25rem, 5vh);
    z-index: 41;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.55em;
    transform: translateX(-50%);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.16em;
    color: color-mix(in oklab, var(--color-accent-soft) 70%, var(--color-ivory));
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.75);
    pointer-events: none;
    opacity: 0;
    transition: opacity 260ms ease-out;
  }

  .aviso-sonido[data-visible] {
    opacity: 0.9;
  }

  .aviso-sonido kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.6em;
    padding: 0.15em 0.35em;
    border: 1px solid color-mix(in oklab, var(--color-accent-soft) 55%, transparent);
    border-radius: var(--radius-xs);
    background: rgba(0, 0, 0, 0.35);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0;
  }

  .zifos {
    color: var(--color-dove);
    transition: color 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .zifos svg {
    transition: filter 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .zifos:hover,
  .zifos:focus-visible {
    color: var(--color-ember);
  }

  .zifos:hover svg,
  .zifos:focus-visible svg {
    filter:
      drop-shadow(0 0 7px color-mix(in oklab, var(--color-accent) 45%, transparent))
      drop-shadow(0 0 18px color-mix(in oklab, var(--color-accent) 30%, transparent));
  }

  @media (prefers-reduced-motion: reduce) {
    .fuego,
    .aviso-sonido {
      display: none;
    }

    .zifos,
    .zifos svg {
      transition: none;
    }

    .zifos:hover svg,
    .zifos:focus-visible svg {
      filter: none;
    }
  }
</style>

<script>
  const BANDA_DESDE = 0.6;
  const BANDA_ALTO = 0.4;
  const SEGUNDOS_DE_ENTRADA = 0.5;
  const SEGUNDOS_DE_SALIDA = 1.2;
  const SEGUNDOS_DE_COLUMNA = 5.5;
  const SEGUNDOS_DE_DISIPARSE = 1.8;
  const PIXELES_POR_SEGUNDO_DE_RETIRADA = 500;
  const RESOLUCION_MAXIMA = 1;
  const VOLUMEN_DEL_FUEGO = 0.55;

  const PALETA = {
    "--color-ember": "#ff3d20",
    "--color-accent-soft": "#ffae94",
    "--color-dove": "#d5d9e2",
  } as const;

  const EXPLORADORAS = [
    { demora: 0, x: 0.68, bajo: 120, v: [0.12, 1700, 650], roce: 2.6, vida: 1.4, calor: 0.55 },
    { demora: 0.08, x: 0.4, bajo: 60, v: [-0.7, 950, -500], roce: 1.7, vida: 1.9, calor: 0.2 },
  ];

  const comoFloat = (valor: number) => valor.toFixed(4);

  const LANZAMIENTOS = EXPLORADORAS.map((e, i) =>
    `sparks += scout(p, uScout - ${comoFloat(e.demora)}, vec2(${comoFloat(e.x)}, ${comoFloat(e.bajo)}),`
    + ` vec3(${comoFloat(e.v[0])}, ${comoFloat(e.v[1])}, ${comoFloat(e.v[2])}),`
    + ` ${comoFloat(e.roce)}, ${comoFloat(e.vida)}, ${comoFloat(e.calor)}, ${comoFloat(i * 1.37 + 0.5)}, view);`,
  ).join("\n      ");

  const VERTICE = `
    attribute vec2 aPos;
    void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
  `;

  const COMUN = `
    precision highp float;
    uniform vec2 uRes;
    uniform float uRatio;
    uniform vec2 uOffset;
    uniform float uTime;
    uniform float uFloor;
    uniform vec2 uBand;
    uniform float uHaze;
    uniform float uFront;
    uniform float uLift;

    vec2 screen() { return vec2(gl_FragCoord.x, uRes.y - gl_FragCoord.y) / uRatio + uOffset; }

    float dither() {
      return (fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453) - 0.5) / 255.0;
    }
  `;

  /* 2D simplex noise (Ashima Arts, MIT). */
  const RUIDO = `
    vec3 permute(vec3 x) { return mod(((x * 34.0) + 1.0) * x, 289.0); }

    float snoise(vec2 v) {
      const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
      vec2 i = floor(v + dot(v, C.yy));
      vec2 x0 = v - i + dot(i, C.xx);
      vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
      vec4 x12 = x0.xyxy + C.xxzz;
      x12.xy -= i1;
      i = mod(i, 289.0);
      vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
      vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
      m = m * m;
      m = m * m;
      vec3 x = 2.0 * fract(p * C.www) - 1.0;
      vec3 h = abs(x) - 0.5;
      vec3 ox = floor(x + 0.5);
      vec3 a0 = x - ox;
      m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
      vec3 g;
      g.x = a0.x * x0.x + h.x * x0.y;
      g.yz = a0.yz * x12.xz + h.yz * x12.yw;
      return 130.0 * dot(m, g);
    }

    float fbm(vec2 p) {
      float sum = 0.0;
      float amp = 0.5;
      for (int i = 0; i < 4; i++) {
        sum += amp * snoise(p);
        p = p * 2.03 + 17.0;
        amp *= 0.5;
      }
      return sum;
    }
  `;

  const CALIMA = `
    vec2 haze(vec2 p) {
      float t = clamp((p.y - uBand.x) / uBand.y, 0.0, 1.0);
      float strength = pow(t, 1.7) * uHaze;
      if (strength <= 0.0) return p;
      vec2 d = vec2(0.0);
      vec2 lenta = vec2(p.x * 0.0050, (p.y + uTime * 34.0) * 0.0180);
      d += vec2(snoise(lenta), snoise(lenta + vec2(17.1, 5.7)));
      vec2 rapida = vec2(p.x * 0.0100, (p.y + uTime * 62.0) * 0.0360) + 41.3;
      d += vec2(snoise(rapida), snoise(rapida + vec2(17.1, 5.7)));
      return p + d * (3.5 * strength);
    }
  `;

  const FRENTE = `
    float smokeBehind(vec2 p) {
      float behind = p.y - uFront;
      float ragged = 150.0
        * smoothstep(-450.0, -150.0, uFront)
        * (1.0 - smoothstep(uFloor + 150.0, uFloor + 450.0, uFront));
      if (ragged <= 0.0) return behind;
      vec2 q = vec2(p.x * 0.004, p.y * 0.003 + uLift * 0.25);
      vec2 warp = vec2(
        fbm(q * 1.4 + vec2(1.7, -uTime * 0.35)),
        fbm(q * 1.4 + vec2(-4.2 + uTime * 0.27, 2.9))
      );
      return behind + fbm(q + 0.9 * warp) * ragged;
    }
  `;

  const FRAGMENTO = `
    ${COMUN}
    ${RUIDO}
    ${CALIMA}
    ${FRENTE}

    uniform float uGlow;
    uniform float uFlash;
    uniform float uSmoke;
    uniform float uAmbient;
    uniform float uSparks;
    uniform float uSparkTime;
    uniform float uBurst;
    uniform float uSwell;
    uniform float uScout;
    uniform float uFlicker;
    uniform vec3 uFire;
    uniform vec3 uBronze;
    uniform vec3 uAsh;

    float hash(float n) { return fract(sin(n) * 43758.5453); }

    vec4 scout(vec2 p, float since, vec2 from, vec3 v, float drag, float life, float heat, float seed, vec2 view) {
      if (since < 0.0 || since > life) return vec4(0.0);
      float slow = exp(-drag * since);
      float travel = (1.0 - slow) / drag;
      float sink = 900.0 / drag;
      vec3 pos = vec3(
        from.x * view.x + v.x * view.x * travel,
        uFloor + from.y - ((v.y + sink) * travel - sink * since),
        v.z * travel
      );
      vec2 center = vec2(view.x * 0.5, uFloor * 0.62);
      float scale = 900.0 / (900.0 - pos.z);
      vec2 d = p - (center + (pos.xy - center) * scale);

      vec2 vel = vec2(v.x * view.x * slow, (v.y + sink) * slow - sink) * scale * vec2(1.0, -1.0);
      float speed = length(vel);
      vec2 dir = speed > 1.0 ? vel / speed : vec2(0.0, -1.0);
      vec2 local = vec2(dot(d, dir), dot(d, vec2(-dir.y, dir.x)));
      if (local.x < 0.0) local.x /= 1.0 + min(speed * 0.004, 3.0);
      float r = length(local);

      float mass = 1.0 - since / life;
      float core = 1.4 * sqrt(mass) * scale;
      float radius = core * 1.6 + 1.5 + 0.012 * abs(pos.z) * scale;
      float wobble = snoise(local / max(r, 0.001) * 1.7 + vec2(seed * 3.1, uTime * 9.0 + seed));
      float edge = radius * (0.7 + 0.4 * wobble);
      float body = 1.0 - smoothstep(edge * 0.4, edge, r);
      float flicker = 0.7 + 0.3 * sin(uTime * 41.0 + seed * 7.0);
      float spark = exp(-r * r / (core * core)) * flicker;
      float light = (body * 0.55 + spark) * clamp(2.4 * core / radius, 0.3, 1.0) * mass;
      light *= smoothstep(0.0, 0.04, since);
      vec3 hot = mix(uFire, mix(uBronze, vec3(1.0), 0.45), heat);
      return vec4(mix(uFire, hot, mass), 1.0) * min(light, 1.0);
    }

    vec4 volley(vec2 p, float since, float width, vec3 hot) {
      vec4 sum = vec4(0.0);
      if (since < 0.0 || since > 2.6) return sum;
      for (int i = 0; i < 7; i++) {
        float seed = float(i) * 5.17 + 101.0;
        float age = since - hash(seed + 6.0) * 0.25;
        if (age < 0.0) continue;
        float rise = 350.0 * (1.0 + hash(seed + 1.0)) * 0.9 * (1.0 - exp(-age / 0.9));
        float dy = p.y - (uFloor + 6.0 - rise);
        if (abs(dy) > 7.0) continue;
        float x = (0.15 + 0.7 * hash(seed)) * width + sin(age * 2.0 + seed) * 12.0
          + (hash(seed + 2.0) - 0.5) * 60.0 * age;
        vec2 d = vec2(p.x - x, dy);
        float radius = 0.9 + 1.2 * hash(seed + 5.0);
        float life = 1.0 - smoothstep(0.0, 1.6 + hash(seed + 3.0) * 0.9, age);
        sum += vec4(mix(hot, uAsh, 1.0 - life), 1.0) * exp(-dot(d, d) / (radius * radius)) * life;
      }
      return sum;
    }

    vec4 swell(vec2 p, float since, float width, vec3 hot) {
      vec4 sum = vec4(0.0);
      if (since < 0.0 || since > 5.5) return sum;
      for (int i = 0; i < 18; i++) {
        float seed = float(i) * 7.31 + 211.0;
        float age = since - hash(seed) * 2.5;
        float life = 2.0 + hash(seed + 1.0) * 1.0;
        if (age < 0.0 || age > life) continue;
        float speed = 50.0 + hash(seed + 2.0) * 40.0;
        float rise = speed * age + 0.5 * 12.0 * age * age;
        float dy = p.y - (uFloor + 4.0 - rise);
        if (abs(dy) > 6.0) continue;
        float x = hash(seed + 3.0) * width
          + sin(age * (1.2 + hash(seed + 4.0)) + seed) * (8.0 + 16.0 * hash(seed + 5.0));
        vec2 d = vec2(p.x - x, dy);
        float radius = 0.7 + 1.0 * hash(seed + 6.0);
        float t = age / life;
        float glow = smoothstep(0.0, 0.1, t) * pow(1.0 - t, 1.3);
        float twinkle = 0.7 + 0.3 * sin(uTime * (7.0 + 6.0 * hash(seed + 7.0)) + seed);
        sum += vec4(mix(hot, uAsh, t), 1.0) * exp(-dot(d, d) / (radius * radius)) * glow * twinkle;
      }
      return sum;
    }

    void main() {
      vec2 view = uRes / uRatio;
      vec2 p = haze(screen());
      float height = uFloor;
      float fromBottom = max(uFloor - p.y, 0.0);

      float light = exp(-fromBottom / (height * 0.12));
      vec4 color = vec4(0.0);
      if (light > 0.004) {
        float sway = 0.75 + 0.25 * snoise(vec2(p.x * 0.0025, uTime * 0.35));
        vec3 orange = min(mix(uFire, uBronze, 0.4) * 1.15, 1.0);
        float warm = 0.5 + 0.5 * snoise(vec2(p.x * 0.0035 + uTime * 0.06, uTime * 0.04));
        warm *= 0.45;
        vec3 hot = mix(uFire, orange, warm + (1.0 - warm) * uFlash * 0.85);
        color = vec4(hot, 1.0) * light * sway * (0.8 + 0.3 * uFlicker) * uGlow * 0.18;
      }

      float column = 0.0;
      if (uSmoke > 0.0) {
        float behind = smokeBehind(p);
        column = smoothstep(-40.0, 60.0, behind) * exp(-max(behind, 0.0) / (height * 0.45))
          * uSmoke * 0.6;
      }
      float amount = column + exp(-fromBottom / (height * 0.14)) * 0.3 * uAmbient;
      if (amount > 0.01) {
        vec2 q = vec2(p.x * 0.004, p.y * 0.003 + uLift * 0.22);
        vec2 warp = vec2(
          fbm(q * 1.6 + vec2(3.1, -uTime * 0.31)),
          fbm(q * 1.6 + vec2(-5.7 + uTime * 0.23, 1.3))
        );
        float wisps = smoothstep(-0.15, 0.7, fbm(q + 0.9 * warp + vec2(0.0, -uTime * 0.07)));
        float soot = smoothstep(-0.1, 0.35, warp.x - warp.y) * 0.6;
        float smoke = amount * wisps * 0.32 * (1.0 + soot * 0.8);
        vec3 lit = mix(uAsh * 0.75, uFire, exp(-fromBottom / (height * 0.07)) * 0.4);
        vec3 tint = mix(lit, lit * 0.08, soot);
        color = vec4(tint, 1.0) * smoke + color * (1.0 - smoke);
      }

      vec4 sparks = vec4(0.0);
      vec3 hot = mix(uBronze, vec3(1.0), 0.35);
      if (uSparks > 0.0) {
        for (int i = 0; i < 16; i++) {
          float fi = float(i);
          float period = 4.0 + hash(fi * 1.31) * 3.0;
          float t = uSparkTime + hash(fi * 7.17) * period;
          float age = fract(t / period);
          if (uSparkTime - age * period < 0.0) continue;
          float seed = fi * 13.73 + floor(t / period) * 7.91;
          float rise = age * period * (60.0 + hash(seed + 1.0) * 80.0);
          float dy = p.y - (uFloor + 6.0 - rise);
          if (abs(dy) > 6.0) continue;
          float x = hash(seed) * view.x
            + sin(rise * 0.02 + seed) * (6.0 + 14.0 * hash(seed + 2.0))
            + sin(rise * 0.0071 + seed * 3.1) * 24.0;
          vec2 d = vec2(p.x - x, dy);
          float radius = 0.7 + 1.1 * hash(seed + 5.0);
          float life = smoothstep(0.0, 0.08, age) * pow(1.0 - age, 1.5);
          float twinkle = 0.65 + 0.35 * sin(uTime * (9.0 + 9.0 * hash(seed + 4.0)) + seed);
          sparks += vec4(mix(hot, uAsh, age), 1.0)
            * exp(-dot(d, d) / (radius * radius)) * life * twinkle;
        }
      }
      sparks *= uSparks * (0.8 + 0.4 * uFlicker);
      ${LANZAMIENTOS}
      sparks += volley(p, uBurst, view.x, hot);
      sparks += swell(p, uSwell, view.x, hot);
      color += min(sparks, 1.0) * (1.0 - color.a);

      color.rgb = clamp(color.rgb + dither(), 0.0, color.a);
      gl_FragColor = color;
    }
  `;

  type Rgb = [number, number, number];

  const UNIFORMES = [
    "time", "floor", "front", "lift", "haze", "glow", "flash",
    "smoke", "ambient", "sparks", "sparkTime", "scout", "burst", "swell", "flicker",
  ] as const;

  type Cuadro = Record<(typeof UNIFORMES)[number], number> & { band: [number, number] };

  function leerColor(raiz: CSSStyleDeclaration, token: keyof typeof PALETA): Rgb {
    const hex = raiz.getPropertyValue(token).trim() || PALETA[token];
    const valor = Number.parseInt(hex.slice(1), 16);
    return [((valor >> 16) & 255) / 255, ((valor >> 8) & 255) / 255, (valor & 255) / 255];
  }

  const mezclar = (desde: Rgb, hasta: Rgb, t: number): Rgb => [
    desde[0] + (hasta[0] - desde[0]) * t,
    desde[1] + (hasta[1] - desde[1]) * t,
    desde[2] + (hasta[2] - desde[2]) * t,
  ];

  const entre = (valor: number, minimo: number, maximo: number) =>
    Math.min(Math.max(valor, minimo), maximo);

  const rampa = (valor: number, desde: number, largo: number) => entre((valor - desde) / largo, 0, 1);
  const suavizar = (t: number) => t * t * (3 - 2 * t);
  const campana = (t: number, ancho: number) => Math.exp(-((t / ancho) ** 2));
  const envolvente = (t: number, sube: number, baja: number) =>
    t < 0 ? 0 : (1 - Math.exp(-t / sube)) * Math.exp(-t / baja);

  function compilar(gl: WebGLRenderingContext, tipo: number, fuente: string) {
    const parte = gl.createShader(tipo);
    if (!parte) return null;
    gl.shaderSource(parte, fuente);
    gl.compileShader(parte);
    return gl.getShaderParameter(parte, gl.COMPILE_STATUS) ? parte : null;
  }

  function crearPrograma(lienzo: HTMLCanvasElement) {
    const gl = lienzo.getContext("webgl", {
      premultipliedAlpha: true,
      antialias: false,
      depth: false,
      failIfMajorPerformanceCaveat: true,
    });
    if (!gl) return null;

    const programa = gl.createProgram();
    const vertice = compilar(gl, gl.VERTEX_SHADER, VERTICE);
    const fragmento = compilar(gl, gl.FRAGMENT_SHADER, FRAGMENTO);
    if (!programa || !vertice || !fragmento) return null;

    gl.attachShader(programa, vertice);
    gl.attachShader(programa, fragmento);
    gl.linkProgram(programa);
    if (!gl.getProgramParameter(programa, gl.LINK_STATUS)) return null;

    gl.useProgram(programa);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const posicion = gl.getAttribLocation(programa, "aPos");
    gl.enableVertexAttribArray(posicion);
    gl.vertexAttribPointer(posicion, 2, gl.FLOAT, false, 0, 0);

    return { gl, lugar: (nombre: string) => gl.getUniformLocation(programa, nombre) };
  }

  function reproductor(fuente: HTMLAudioElement | null, aviso: HTMLElement | null) {
    if (!fuente) return null;

    const pista = fuente;
    let permitido = true;
    let sonando = false;

    function mostrarAviso(visible: boolean) {
      if (!aviso) return;
      if (visible) {
        aviso.hidden = false;
        requestAnimationFrame(() => aviso.setAttribute("data-visible", ""));
      } else {
        aviso.removeAttribute("data-visible");
        setTimeout(() => {
          if (!aviso.hasAttribute("data-visible")) aviso.hidden = true;
        }, 320);
      }
    }

    function tocar(desdeElPrincipio: boolean) {
      if (desdeElPrincipio && pista.readyState > 0) pista.currentTime = 0;
      pista.volume = 0;
      return pista.play();
    }

    function destrabar() {
      permitido = true;
      mostrarAviso(false);
      removeEventListener("pointerdown", destrabar);
      removeEventListener("keydown", atajo);
    }

    function atajo(evento: KeyboardEvent) {
      if (evento.key !== "s" && evento.key !== "S") return;
      tocar(true)
        .then(() => {
          destrabar();
          if (!sonando) pista.pause();
        })
        .catch(() => mostrarAviso(sonando));
    }

    return {
      volumen(valor: number) {
        pista.volume = entre(valor * VOLUMEN_DEL_FUEGO, 0, 1);
      },
      arrancar(desdeElPrincipio: boolean) {
        sonando = true;
        if (!permitido) {
          mostrarAviso(true);
          return;
        }
        tocar(desdeElPrincipio).catch(() => {
          permitido = false;
          mostrarAviso(true);
          addEventListener("pointerdown", destrabar, { once: true });
          addEventListener("keydown", atajo);
        });
      },
      retirar() {
        sonando = false;
        mostrarAviso(false);
      },
      frenar() {
        sonando = false;
        pista.pause();
      },
    };
  }

  function encender(
    lienzo: HTMLCanvasElement,
    disparadores: HTMLElement[],
    pista: HTMLAudioElement | null,
    aviso: HTMLElement | null,
  ) {
    const motor = crearPrograma(lienzo);
    if (!motor) return;
    const { gl, lugar } = motor;
    const sonido = reproductor(pista, aviso);

    const raiz = getComputedStyle(document.documentElement);
    const fuego = leerColor(raiz, "--color-ember");
    const brasa = leerColor(raiz, "--color-accent-soft");
    const ceniza = mezclar(brasa, leerColor(raiz, "--color-dove"), 0.55);
    gl.uniform3fv(lugar("uFire"), fuego);
    gl.uniform3fv(lugar("uBronze"), brasa);
    gl.uniform3fv(lugar("uAsh"), ceniza);

    const resolucion = lugar("uRes");
    const proporcion = lugar("uRatio");
    const corrimiento = lugar("uOffset");
    const banda = lugar("uBand");
    const lugares = Object.fromEntries(
      UNIFORMES.map((nombre) => [nombre, lugar(`u${nombre[0].toUpperCase()}${nombre.slice(1)}`)]),
    ) as Record<(typeof UNIFORMES)[number], WebGLUniformLocation | null>;

    const escala = Math.min(devicePixelRatio || 1, RESOLUCION_MAXIMA);

    const ajustar = () => {
      const caja = lienzo.getBoundingClientRect();
      const ancho = Math.round(caja.width * escala);
      const alto = Math.round(caja.height * escala);
      if (lienzo.width !== ancho || lienzo.height !== alto) {
        lienzo.width = ancho;
        lienzo.height = alto;
        gl.viewport(0, 0, ancho, alto);
      }
      gl.uniform2f(resolucion, ancho, alto);
      gl.uniform1f(proporcion, escala);
      gl.uniform2f(corrimiento, caja.left, caja.top);
      return caja;
    };

    let intensidad = 0;
    let objetivo = 0;
    let anterior = 0;
    let cuadro = 0;
    let prendidoEn = -1;
    let arrastre = 0;

    const dibujar = (ahora: number) => {
      const paso = Math.min((ahora - anterior) / 1000, 0.1);
      anterior = ahora;
      const tiempo = (ahora / 1000) % 1000;

      const constante = objetivo > intensidad ? SEGUNDOS_DE_ENTRADA : SEGUNDOS_DE_SALIDA;
      intensidad += Math.sign(objetivo - intensidad)
        * Math.min(Math.abs(objetivo - intensidad), paso / constante);

      sonido?.volumen(intensidad);

      if (objetivo === 0 && intensidad <= 0.002) {
        intensidad = 0;
        cuadro = 0;
        lienzo.removeAttribute("data-prendido");
        sonido?.frenar();
        return;
      }

      const edad = prendidoEn < 0 ? -1 : ahora / 1000 - prendidoEn;
      const empuje = envolvente(edad, 0.08, 1.1);
      const estallido = envolvente(edad, 0.25, 2) * 1.5;
      const chispazo = edad < 0 ? 0 : campana(edad - 0.08, 0.18);
      const arranque = 0.3 * suavizar(rampa(edad, 0, 0.5));
      const asentado = suavizar(rampa(edad, 0, 1.5));
      arrastre += paso * (1 + 5 * empuje);

      const caja = ajustar();
      const piso = caja.height;
      const latido = 0.5 + 0.25 * Math.sin(tiempo * 1.7) + 0.15 * Math.sin(tiempo * 2.9 + 1)
        + 0.1 * Math.sin(tiempo * 5.3 + 2) + 0.5 * empuje;

      const subida = rampa(edad, 0, SEGUNDOS_DE_COLUMNA);
      const frente = piso + 160 - (piso + 160 + PIXELES_POR_SEGUNDO_DE_RETIRADA)
        * (1 - (1 - subida) ** 2);
      const disipa = suavizar(
        rampa(edad, SEGUNDOS_DE_COLUMNA - SEGUNDOS_DE_DISIPARSE, SEGUNDOS_DE_DISIPARSE),
      );

      const valores: Cuadro = {
        time: tiempo,
        floor: piso,
        front: frente,
        lift: arrastre,
        haze: intensidad * (rampa(edad, 0.5, 3) ** 2 + 1.4 * empuje) * (0.85 + 0.3 * latido),
        glow: intensidad * (arranque + 0.7 * asentado + chispazo + 0.9 * estallido),
        flash: Math.min(chispazo + estallido, 1),
        smoke: intensidad * rampa(edad, 0, 0.3) * (1 + 0.6 * empuje) * (1 - disipa),
        ambient: intensidad * asentado,
        sparks: intensidad * (arranque + 0.7 * asentado),
        sparkTime: edad,
        scout: edad,
        burst: edad,
        swell: edad - 1.2,
        flicker: latido,
        band: [caja.height * BANDA_DESDE, caja.height * BANDA_ALTO],
      };

      gl.uniform2f(banda, valores.band[0], valores.band[1]);
      for (const nombre of UNIFORMES) gl.uniform1f(lugares[nombre], valores[nombre]);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

      cuadro = requestAnimationFrame(dibujar);
    };

    const avivar = (encendido: boolean) => {
      objetivo = encendido ? 1 : 0;
      const reinicia = encendido && intensidad < 0.15;
      if (reinicia) prendidoEn = performance.now() / 1000;
      if (encendido) {
        lienzo.setAttribute("data-prendido", "");
        sonido?.arrancar(reinicia);
      } else {
        sonido?.retirar();
      }
      if (cuadro) return;
      anterior = performance.now();
      cuadro = requestAnimationFrame(dibujar);
    };

    lienzo.addEventListener("webglcontextlost", () => {
      cuadro = 0;
      lienzo.removeAttribute("data-prendido");
      sonido?.frenar();
    });

    for (const disparador of disparadores) {
      disparador.addEventListener("pointerenter", () => avivar(true));
      disparador.addEventListener("pointermove", () => avivar(true));
      disparador.addEventListener("pointerleave", () => avivar(false));
      disparador.addEventListener("focus", () => avivar(true));
      disparador.addEventListener("blur", () => avivar(false));
    }

    const soltar = () => {
      avivar(false);
      sonido?.frenar();
    };

    addEventListener("blur", soltar);
    addEventListener("pagehide", soltar);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) soltar();
    });
  }

  const lienzo = document.querySelector<HTMLCanvasElement>("[data-fuego]");
  const pista = document.querySelector<HTMLAudioElement>("[data-fuego-audio]");
  const aviso = document.querySelector<HTMLElement>("[data-aviso-sonido]");
  const disparadores = [...document.querySelectorAll<HTMLElement>("[data-zifos]")];

  if (lienzo && disparadores.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    encender(lienzo, disparadores, pista, aviso);
  }
</script>
