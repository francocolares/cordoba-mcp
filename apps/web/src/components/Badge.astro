---
interface Props {
  tone?: "accent" | "quiet";
  class?: string;
}

const { tone = "quiet", class: extra = "" } = Astro.props;

const tonos = {
  accent: "border-accent/40 bg-accent/10 text-accent-soft",
  quiet: "border-line-strong bg-white/[0.02] text-muted",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-mono text-[0.6875rem] leading-5",
    tonos[tone],
    extra,
  ]}
>
  <slot />
</span>
