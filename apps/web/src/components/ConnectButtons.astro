---
import { VIDEO_PRESENTACION } from "../data/content";
import BrandIcon from "./BrandIcon.astro";
import PlayIcon from "./PlayIcon.astro";
import VideoModal from "./VideoModal.astro";

const modal = "video-presentacion";
---

<div class="flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
  <a
    href="#conectar"
    data-evento="conectar_claude"
    class="inline-flex items-center justify-center gap-2.5 rounded-card bg-ink px-5 py-3 text-sm font-medium text-jet no-underline transition-colors hover:bg-dove"
  >
    <BrandIcon name="claude-icon" class="size-[18px]" />
    Conectar con Claude
  </a>

  <button
    type="button"
    data-abrir-video={modal}
    data-evento="ver_video"
    class="inline-flex items-center justify-center gap-2.5 rounded-card border border-line-strong bg-surface px-5 py-3 text-sm font-medium text-ink transition-colors hover:bg-white/[0.06]"
  >
    <PlayIcon class="size-[18px]" />
    Conocé más
  </button>
</div>

<VideoModal id={modal} titulo="Video de presentación de Córdoba MCP" fuente={VIDEO_PRESENTACION} />
