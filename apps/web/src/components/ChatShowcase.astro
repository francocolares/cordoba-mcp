---
import type { Conversacion } from "../data/conversaciones";
import BrandIcon from "./BrandIcon.astro";
import ChatPanel from "./ChatPanel.astro";
import OrigamiFuente from "./OrigamiFuente.astro";
import ParticulasOrigami from "./ParticulasOrigami.astro";
import WrenchIcon from "./WrenchIcon.astro";

interface Props {
  conversaciones: Conversacion[];
}

const { conversaciones } = Astro.props;

/** El encabezado del chat es uno solo: el JS necesita saber qué id está en obra. */
const enObra = conversaciones.filter((c) => c.proximamente).map((c) => c.id);
---

<!-- Sin `border-t`: la costura de arriba es la que cierra el hero (ver Hero.astro). -->
<section id="demo" class="py-20 sm:py-28">
  <!--
    Sonda de alto: mide 100svh (la ventana con las barras del navegador a la
    vista) sin participar del layout. El script la usa para que el gadget
    entre en la pantalla del celular.
  -->
  <div data-sonda aria-hidden="true" class="pointer-events-none invisible fixed top-0 left-0 h-[100svh] w-0"></div>

  <div class="shell">
    <h2 class="mx-auto max-w-[24ch] text-center text-3xl sm:text-4xl lg:text-5xl">
      Conversá con Córdoba, como lo harías con un amigo
    </h2>

    <!--
      La pista y el gadget comparten celda de grilla: la pista da el alto por
      el que dura el scroll, el gadget queda pegajoso y centrado encima.
    -->
    <div class="mt-12 grid grid-cols-[minmax(0,1fr)] sm:mt-16">
      <div class="col-start-1 row-start-1" aria-hidden="true">
        {
          conversaciones.map((c) => (
            <div class="h-[44svh] lg:h-[52vh]" data-etapa={c.id} />
          ))
        }
      </div>

      <div class="col-start-1 row-start-1 min-w-0" aria-hidden="true">
        <div class="sticky top-[4.5rem] lg:top-28">
          <div class="telon mx-auto h-[min(42rem,82svh)] w-full" data-telon>
            <ParticulasOrigami ids={conversaciones.map((c) => c.id)} />

            <div class="figuras absolute inset-x-0 top-1/2 h-[min(34rem,68svh)] -translate-y-1/2">
              {
                conversaciones.map((c, i) => (
                  <OrigamiFuente
                    id={c.id}
                    lado={i % 2 === 0 ? "derecha" : "izquierda"}
                    visible={i === 0}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="col-start-1 row-start-1 z-10 min-w-0">
        <div class="sticky top-[4.5rem] mx-auto w-full max-w-xl lg:top-28" data-gadget>
          <div
            class="pestanas -mx-5 overflow-x-auto px-5 pb-4 sm:mx-0 sm:px-0"
            data-pestanas
          >
            <!-- w-max + min-w-full: centrado cuando entra, pegado al inicio cuando desborda. -->
            <div class="flex w-max min-w-full justify-center gap-2" role="tablist">
              {
                conversaciones.map((c, i) => (
                  <button
                    type="button"
                    role="tab"
                    class:list={[
                      "pestana inline-flex shrink-0 items-center gap-1.5 rounded-full border px-4 py-1.5 text-sm transition-colors",
                      c.proximamente
                        ? "pestana-obra border-line-strong text-muted"
                        : "pestana-live",
                    ]}
                    data-pestana={c.id}
                    aria-selected={i === 0 ? "true" : "false"}
                  >
                    {c.proximamente ? (
                      <WrenchIcon class="size-3.5 opacity-70" />
                    ) : (
                      <span class="pulso-live size-2 rounded-full bg-current" />
                    )}
                    {c.etiqueta}
                    <span class="sr-only">
                      {c.proximamente ? " — en construcción" : " — funcionando"}
                    </span>
                  </button>
                ))
              }
            </div>
          </div>

          <div
            class="chat overflow-hidden rounded-card border border-claude-line bg-claude-bg text-claude-text shadow-2xl shadow-black/50"
            data-chat
          >
            <div class="flex items-center gap-2 border-b border-claude-line px-4 py-2.5 sm:py-3">
              <BrandIcon name="claude-icon" class="size-4 text-claude-accent" />
              <span class="text-sm text-claude-muted">Claude</span>

              <span
                class="ml-auto inline-flex items-center gap-1.5 rounded-full border border-dashed border-claude-muted/50 px-2.5 py-0.5 text-[0.6875rem] font-medium text-claude-muted"
                data-construccion
                data-en-obra={enObra.join(" ")}
                hidden
              >
                <WrenchIcon class="size-3" />
                En construcción
              </span>

              <span
                class="ml-auto inline-flex items-center gap-1.5 rounded-full border border-live/40 bg-live/10 px-2.5 py-0.5 text-[0.6875rem] font-medium text-live-soft"
                data-andando
              >
                <span class="pulso-live size-1.5 rounded-full bg-live"></span>
                Funcionando
              </span>
            </div>

            <div class="grid">
              {conversaciones.map((c, i) => <ChatPanel conversacion={c} activa={i === 0} />)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .telon {
    display: none;
    position: relative;
    overflow: clip;
    color: color-mix(in oklab, var(--color-accent) 42%, var(--color-fog));
  }

  .figuras {
    overflow: clip;
    opacity: 0.22;
    mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent);
  }

  @media (min-width: 640px) {
    .telon {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .figuras {
      opacity: 0.28;
    }
  }
</style>

<script>
  import {
    elegirEventos,
    formatearEvento,
    type ItemChat,
    parsearJsonl,
  } from "../lib/demoEventos";
  import { type CalendarioCrudo, elegirGuardia, parsearFarmacias } from "../lib/demoFarmacias";

  const chat = document.querySelector<HTMLElement>("[data-chat]");
  const etapas = [...document.querySelectorAll<HTMLElement>("[data-etapa]")];
  const barra = document.querySelector<HTMLElement>("[data-pestanas]");
  const pestanas = new Map(
    [...document.querySelectorAll<HTMLElement>("[data-pestana]")].map((b) => [b.dataset.pestana, b]),
  );
  const paneles = new Map(
    [...document.querySelectorAll<HTMLElement>("[data-panel]")].map((p) => [p.dataset.panel, p]),
  );

  const chipObra = document.querySelector<HTMLElement>("[data-construccion]");
  const chipAndando = document.querySelector<HTMLElement>("[data-andando]");
  const enObra = new Set((chipObra?.dataset.enObra ?? "").split(" ").filter(Boolean));

  const fondos = new Map(
    [...document.querySelectorAll<HTMLElement>("[data-fondo]")].map((f) => [f.dataset.fondo, f]),
  );
  const telon = document.querySelector<HTMLElement>("[data-telon]");
  const particulas = document.querySelector<HTMLElement>("[data-particulas]");
  const enjambres = new Map(
    [...document.querySelectorAll<HTMLElement>("[data-enjambre]")].map((e) => [e.dataset.enjambre, e]),
  );

  const sonda = document.querySelector<HTMLElement>("[data-sonda]");
  const gadget = document.querySelector<HTMLElement>("[data-gadget]");

  /** Lo más chico que lo achicamos: por debajo preferimos que sobre un pelito. */
  const ESCALA_MINIMA = 0.72;

  /*
   * El gadget es pegajoso: si mide más que la pantalla, el celular lo muestra
   * cortado. Medimos con 100svh —la ventana chica, con las barras del
   * navegador a la vista— para que el alto no cambie mientras se scrollea, y
   * si no entra lo achicamos con `zoom`, que encoge el layout de verdad: así
   * el bloque pegajoso termina midiendo lo mismo que se ve.
   */
  function ajustarAlto() {
    if (!chat || !gadget) return;

    chat.style.zoom = "";
    const alto = sonda?.offsetHeight || window.innerHeight;
    const tope = Number.parseFloat(getComputedStyle(gadget).top) || 0;
    const disponible = alto - tope - (barra?.offsetHeight ?? 0) - 16;
    const natural = chat.offsetHeight;
    if (!natural || disponible <= 0) return;

    const escala = Math.max(ESCALA_MINIMA, Math.min(1, disponible / natural));
    if (escala < 0.995) chat.style.zoom = escala.toFixed(3);
  }

  let pendiente = 0;
  function pedirAjuste() {
    if (pendiente) return;
    pendiente = requestAnimationFrame(() => {
      pendiente = 0;
      ajustarAlto();
    });
  }

  ajustarAlto();
  window.addEventListener("resize", pedirAjuste);
  window.addEventListener("orientationchange", pedirAjuste);
  document.fonts?.ready.then(ajustarAlto);

  let visible: string | null = null;

  let frameDeriva = 0;

  function pintarDeriva() {
    frameDeriva = 0;
    const etapa = etapas.find((e) => e.dataset.etapa === visible);
    if (!telon || !etapa) return;

    const caja = etapa.getBoundingClientRect();
    const medio = window.innerHeight / 2;
    const avance = Math.max(-1, Math.min(1, (caja.top + caja.height / 2 - medio) / medio));
    telon.style.setProperty("--avance", avance.toFixed(3));
  }

  function pedirDeriva() {
    if (!frameDeriva) frameDeriva = requestAnimationFrame(pintarDeriva);
  }

  window.addEventListener("scroll", pedirDeriva, { passive: true });
  window.addEventListener("resize", pedirDeriva);
  pedirDeriva();

  const seccion = document.querySelector<HTMLElement>("#demo");
  const quieto = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (seccion && telon) {
    seccion.addEventListener(
      "pointermove",
      (evento) => {
        if (quieto.matches || evento.pointerType !== "mouse") return;
        const caja = telon.getBoundingClientRect();
        const mx = ((evento.clientX - caja.left) / caja.width) * 2 - 1;
        const my = ((evento.clientY - caja.top) / caja.height) * 2 - 1;
        telon.style.setProperty("--mx", mx.toFixed(3));
        telon.style.setProperty("--my", my.toFixed(3));
      },
      { passive: true },
    );

    seccion.addEventListener(
      "pointerleave",
      () => {
        telon.style.setProperty("--mx", "0");
        telon.style.setProperty("--my", "0");
      },
      { passive: true },
    );
  }

  function mostrar(id: string) {
    if (id === visible) return;
    visible = id;

    const obra = enObra.has(id);
    if (chipObra) chipObra.hidden = !obra;
    if (chipAndando) chipAndando.hidden = obra;

    for (const [clave, panel] of paneles) {
      const activa = clave === id;
      panel.classList.toggle("listo", activa);
      panel.classList.toggle("opacity-0", !activa);
      panel.classList.toggle("pointer-events-none", !activa);
      if (activa) panel.removeAttribute("aria-hidden");
      else panel.setAttribute("aria-hidden", "true");
    }

    for (const [clave, boton] of pestanas) {
      boton.setAttribute("aria-selected", clave === id ? "true" : "false");
    }

    for (const [clave, fondo] of fondos) {
      fondo.classList.toggle("visible", clave === id);
    }

    for (const [clave, grupo] of enjambres) {
      grupo.classList.toggle("visible", clave === id);
    }

    pedirDeriva();

    /* En pantallas chicas la pestaña activa se trae al centro de su carril. */
    const activa = pestanas.get(id);
    if (barra && activa && barra.scrollWidth > barra.clientWidth) {
      barra.scrollTo({
        left: activa.offsetLeft - (barra.clientWidth - activa.offsetWidth) / 2,
        behavior: "smooth",
      });
    }
  }

  if (chat && etapas.length) {
    /*
     * La franja que decide qué etapa manda tiene que caer donde el gadget
     * queda pegado: al 55% del alto en escritorio y cerca del borde de arriba
     * en celulares, así la primera etapa manda desde que el gadget se pega.
     */
    const angosta = window.matchMedia("(max-width: 1023px)");
    const ALTURA_FRANJA_ANGOSTA = 0.18;
    const ALTURA_FRANJA_ANCHA = 0.55;
    const alturaFranja = () => (angosta.matches ? ALTURA_FRANJA_ANGOSTA : ALTURA_FRANJA_ANCHA);
    const franja = () => {
      const arriba = Math.round(alturaFranja() * 100);
      return `-${arriba}% 0px -${99 - arriba}% 0px`;
    };

    const cruzando = new Set<string>();
    let observador: IntersectionObserver | null = null;

    const alCruzar: IntersectionObserverCallback = (entradas) => {
      for (const entrada of entradas) {
        const id = (entrada.target as HTMLElement).dataset.etapa;
        if (!id) continue;
        if (entrada.isIntersecting) cruzando.add(id);
        else cruzando.delete(id);
      }

      /* El gadget se enciende sólo mientras hay una etapa en la franja. */
      chat.classList.toggle("activo", cruzando.size > 0);
      particulas?.classList.toggle("activo", cruzando.size > 0);

      const primera = etapas.find((e) => e.dataset.etapa && cruzando.has(e.dataset.etapa));
      if (primera?.dataset.etapa) mostrar(primera.dataset.etapa);
    };

    const montar = () => {
      observador?.disconnect();
      cruzando.clear();
      observador = new IntersectionObserver(alCruzar, { rootMargin: franja(), threshold: 0 });
      for (const etapa of etapas) observador.observe(etapa);
    };

    montar();
    angosta.addEventListener("change", montar);

    /* Las pestañas también navegan: llevan el scroll a su etapa. */
    for (const [id, boton] of pestanas) {
      boton.addEventListener("click", () => {
        const etapa = etapas.find((e) => e.dataset.etapa === id);
        if (!etapa) return;
        const caja = etapa.getBoundingClientRect();
        window.scrollTo({
          top: Math.round(
            window.scrollY + caja.top + caja.height / 2 - innerHeight * alturaFranja(),
          ),
          behavior: "smooth",
        });
      });
    }
  }

  /* Primero el worker local y después el de producción (la landing también se
     abre desde un build estático suelto). Si ninguno contesta, queda lo del build. */
  async function bajar(ruta: string, accept: string): Promise<string | null> {
    for (const base of ["", "https://cordobamcp.com"]) {
      try {
        const r = await fetch(`${base}${ruta}`, { headers: { accept } });
        if (!r.ok) continue;
        return await r.text();
      } catch {
        // Probamos la siguiente.
      }
    }
    return null;
  }

  /* Datos frescos: lo del build sirve de piso, esto lo pisa si el worker contesta. */
  async function refrescarAgenda() {
    const lista = document.querySelector<HTMLElement>('[data-items="agenda"]');
    if (!lista) return;

    const texto = await bajar("/api/eventos.jsonl", "application/x-ndjson");
    if (!texto) return;

    const items = elegirEventos(parsearJsonl(texto)).map(formatearEvento);
    if (!items.length) return;

    const base = Number(lista.dataset.pasoBase ?? "3");
    lista.replaceChildren(...items.map((item, i) => nodoItem(item, base + i)));
    pedirAjuste();
  }

  function nodoItem(item: ItemChat, paso: number): HTMLLIElement {
    const li = document.createElement("li");
    li.className = "paso rounded-xl border border-claude-line bg-claude-surface/50 p-2.5 sm:p-3";
    li.style.setProperty("--paso", String(paso));

    const cabeza = document.createElement("p");
    cabeza.className = "flex items-baseline justify-between gap-3 font-medium";

    const titulo = document.createElement("span");
    titulo.className = "min-w-0";
    titulo.textContent = item.titulo;
    cabeza.append(titulo);

    if (item.etiqueta) {
      const etiqueta = document.createElement("span");
      etiqueta.className = "shrink-0 font-mono text-[0.625rem] text-claude-accent";
      etiqueta.textContent = item.etiqueta;
      cabeza.append(etiqueta);
    }

    const meta = document.createElement("p");
    meta.className = "mt-1 text-[0.8125rem] text-claude-muted";
    meta.textContent = item.meta;

    li.append(cabeza, meta);
    return li;
  }

  /*
   * La guardia depende del día, así que el HTML del build envejece de un día
   * para el otro: la resolvemos en el navegador con el turnero y las farmacias
   * que sirve el worker. Si no hay turnero para hoy, dejamos lo que haya.
   */
  async function refrescarFarmacias() {
    const lista = document.querySelector<HTMLElement>('[data-items="farmacias"]');
    if (!lista) return;

    const [crudas, turnos] = await Promise.all([
      bajar("/api/farmacias_turno.jsonl", "application/x-ndjson"),
      bajar("/api/farmacias_turno/turnos.json", "application/json"),
    ]);
    if (!crudas || !turnos) return;

    let calendarios: CalendarioCrudo[] = [];
    try {
      calendarios = (JSON.parse(turnos) as { calendars: CalendarioCrudo[] }).calendars ?? [];
    } catch {
      return;
    }

    const guardia = elegirGuardia(parsearFarmacias(crudas), calendarios);
    if (guardia.items.length === 0) return;

    const intro = document.querySelector<HTMLElement>('[data-intro="farmacias"]');
    if (intro && guardia.turno !== null) {
      intro.textContent = `Hoy está de guardia el turno ${guardia.turno}. Dos que te quedan cerca del Centro:`;
    }

    const base = Number(lista.dataset.pasoBase ?? "3");
    lista.replaceChildren(...guardia.items.map((item, i) => nodoItem(item, base + i)));
    pedirAjuste();
  }

  refrescarAgenda();
  refrescarFarmacias();
</script>
