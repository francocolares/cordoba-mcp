---
/** Sobre: acompaña a Contacto en la lista del pie, donde las otras dos entradas
 * llevan el logo de su plataforma. */
interface Props {
  class?: string;
}

const { class: extra = "" } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-hidden="true"
  class:list={["shrink-0", extra]}
>
  <rect x="3" y="5.5" width="18" height="13" rx="2.5"></rect>
  <path d="m3.8 7.3 7.1 5.1a2 2 0 0 0 2.2 0l7.1-5.1"></path>
</svg>
