---
import type { Cliente } from "../data/content";
import BrandIcon from "./BrandIcon.astro";

interface Props {
  cliente: Cliente;
}

const { cliente } = Astro.props;
---

<article
  id={cliente.id}
  class="flex scroll-mt-24 flex-col rounded-card border border-line bg-surface p-6 sm:p-7"
>
  <div class="flex items-center gap-3">
    <span
      class="flex size-10 items-center justify-center rounded-card border border-line-strong bg-bg text-ink"
    >
      <BrandIcon name={cliente.icono} class="size-5" />
    </span>
    <h3 class="text-2xl">{cliente.nombre}</h3>
  </div>

  <p class="mt-3 text-sm text-muted">{cliente.detalle}</p>

  <ol class="mt-6 space-y-0">
    {
      cliente.pasos.map((paso, i) => (
        <li class="flex gap-4 border-t border-line py-3.5 text-sm">
          <span class="font-mono text-xs text-accent tabular-nums" aria-hidden="true">
            {i + 1}
          </span>
          <span>{paso}</span>
        </li>
      ))
    }
  </ol>

  {
    cliente.aviso && (
      <p class="mt-auto border-t border-line pt-4 font-mono text-xs leading-relaxed text-muted">
        {cliente.aviso}
      </p>
    )
  }
</article>
