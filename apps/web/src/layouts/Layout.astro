---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const SITIO = "Córdoba MCP";
const IMAGEN_SOCIAL = "/og.png";
const TEXTO_DE_LA_IMAGEN = "Los datos abiertos de Córdoba, al alcance de tu agente.";

const canonica = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL(IMAGEN_SOCIAL, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITIO} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={TEXTO_DE_LA_IMAGEN} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagen} />
    <meta name="twitter:image:alt" content={TEXTO_DE_LA_IMAGEN} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <!-- Lo genera `src/pages/favicon.svg.ts` a partir del isotipo. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />

    {/*
      Visitas y Web Vitals no se miden acá: el dominio está en Cloudflare y Web
      Analytics inyecta su beacon en el edge (automatic setup). Agregar el
      script a mano contaría cada pageview dos veces.

      Esto son los eventos propios, que Web Analytics no sabe medir: el embudo
      hacia el MCP. Ver src/lib/analitica.ts.
    */}
    <script>
      import { iniciarAnalitica } from "../lib/analitica";
      iniciarAnalitica();
    </script>
  </body>
</html>
