{
  "name": "@cordoba/scraper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/index.ts validate",
    "scrape": "tsx src/index.ts scrape",
    "run": "tsx src/index.ts run"
  },
  "dependencies": {
    "@cordoba/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "cordoba-scraper": "./dist/index.js"
  }
}
