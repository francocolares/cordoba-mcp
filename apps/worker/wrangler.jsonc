{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cordoba-agenda",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  // La landing de Astro se sirve como assets estáticos; el Worker sólo
  // intercepta /mcp, /health y /api/*.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Dominio propio: un único hostname para todo (landing, /mcp, /health, /api/*),
  // que es lo que el ruteo por path ya permite sin código extra.
  // El Custom Domain crea el registro DNS y emite el certificado solo, pero la
  // zona tiene que estar en la MISMA cuenta de Cloudflare que el Worker.
  // `workers.dev` queda activo a propósito: la Action usa esa URL para el smoke
  // test inmediato, sin esperar la propagación del dominio.
  "routes": [{ "pattern": "cordobamcp.com", "custom_domain": true }],
  // Los datasets viven en R2, no en el bundle: los sube el workflow que
  // scrapea (scripts/sync-r2.mjs) y el Worker los lee con cache en el isolate
  // y en la caché del edge. Así el cron de cada fuente no depende del deploy.
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "cordoba-mcp-data"
    }
  ],
  // Telemetría agregada del MCP y de la landing (ver src/analytics.ts). El
  // dataset se crea solo en el primer `writeDataPoint`, así que no hay nada que
  // aprovisionar antes del deploy. El nombre sale de core (ANALYTICS_DATASET).
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cordoba_mcp_uso"
    }
  ],
  "observability": {
    "enabled": true
  }
}
